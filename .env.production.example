NODE_ENV=production
APP_ROLE=api
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

MUDAY_API_HOST_PORT=6030
MUDAY_MINIAPP_HOST_PORT=3030
MUDAY_LANDING_HOST_PORT=5050
POSTGRES_DB=muday
POSTGRES_USER=muday
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://muday:replace_with_a_long_random_password@postgres:5432/muday?schema=public
REDIS_URL=redis://redis:6379

PUBLIC_API_URL=https://mudayai.learnica.net/backend
MINIAPP_URL=https://mudayai.learnica.net
FLUTTER_DEEP_LINK_BASE=https://app.muday.et
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_64_hex_characters
TELEGRAM_WEBHOOK_PATH=/webhook/telegram

CONSENT_VERSION=2026-08-receipt-v1
DELETION_POLICY_VERSION=1.0
ALLOW_LOCAL_DEV_AUTH=false
LOCAL_DEV_TELEGRAM_ID=100000001
MINIAPP_INIT_DATA_MAX_AGE_SECONDS=3600
ADMIN_JWT_SECRET=replace_with_an_independent_64_hex_character_secret
DASHBOARD_RATE_LIMIT_PER_MINUTE=30
DASHBOARD_EVENT_DEDUP_SECONDS=900

# Primary voice path: temporary WAV -> Hasab or AddisAI transcript -> Gemini extraction.
# STT providers: hasab | addisai | fake | local | remote
STT_PROVIDER=hasab
STT_MODEL=hasab-transcription-v1
STT_LOCAL_COMMAND_OR_URL=
STT_MODEL_PATH=.local/models

# Hasab STT (active if STT_PROVIDER=hasab)
HASAB_API_KEY=replace_me
HASAB_BASE_URL=https://api.hasab.ai/api
HASAB_TIMEOUT_MS=60000
HASAB_MAX_RETRIES=2
HASAB_RETRY_BASE_DELAY_MS=250
HASAB_MAX_RESPONSE_BYTES=1000000
HASAB_DAILY_REQUEST_LIMIT=100
HASAB_CIRCUIT_FAILURE_THRESHOLD=3
HASAB_CIRCUIT_COOLDOWN_SECONDS=300

# AddisAI STT (active if STT_PROVIDER=addisai)
ADDISAI_API_KEY=replace_me
ADDISAI_BASE_URL=https://api.addisassistant.com/api
ADDISAI_TIMEOUT_MS=60000
ADDISAI_MAX_RETRIES=2
ADDISAI_RETRY_BASE_DELAY_MS=250
ADDISAI_MAX_RESPONSE_BYTES=1000000
ADDISAI_DAILY_REQUEST_LIMIT=100
ADDISAI_CIRCUIT_FAILURE_THRESHOLD=3
ADDISAI_CIRCUIT_COOLDOWN_SECONDS=300

FAKE_STT_TRANSCRIPT=I spent 250 birr on lunch

EXTRACTION_PROVIDER=gemini
EXTRACTION_MODEL=gemini-3.6-flash
EXTRACTION_PROMPT_VERSION=hasab-stt-gemini-v1
EXTRACTION_LOCAL_BASE_URL=http://localhost:11434/v1
VOICE_EXTRACTION_MODE=stt_then_extract
RECEIPT_TEMP_DIR=/app/.local/tmp/receipt
RECEIPT_QUEUE_NAME=muday-receipts
SMS_QUEUE_NAME=muday-sms
MAX_RECEIPT_FILE_BYTES=10000000
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash
# Optional override for direct audio extraction model
# GEMINI_AUDIO_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=60000
GEMINI_AUDIO_MAX_RETRIES=2
GEMINI_MAX_INLINE_AUDIO_BYTES=12000000
GEMINI_AUDIO_DEBUG_LOG=false

# Rollback/comparison only: set VOICE_EXTRACTION_MODE=direct to send WAV directly to Gemini.
# Direct mode requires EXTRACTION_PROVIDER=gemini but does not use STT_PROVIDER.

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VOICE_TEMP_DIR=/app/.local/tmp/voice
VOICE_QUEUE_NAME=muday-voice
NOTIFICATION_QUEUE_NAME=muday-notifications
MAX_VOICE_DURATION_SECONDS=120
MAX_VOICE_FILE_BYTES=20000000
VOICE_AUDIO_SAMPLE_RATE=24000
MAX_MESSAGE_CHARACTERS=2000
MAX_TRANSACTIONS_PER_MESSAGE=10

# Customer Auth (Bot pairing code auth)
CUSTOMER_AUTH_ENABLED=true
APP_CODE_PEPPER=replace_with_an_independent_64_hex_character_pepper
APP_CODE_RATE_LIMIT_PER_HOUR=5
CUSTOMER_JWT_SECRET=replace_with_an_independent_64_hex_character_secret
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_REFRESH_TOKEN_TTL_SECONDS=2592000
