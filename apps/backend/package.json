{
  "name": "@mezgeb/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch src/main-api.ts",
    "dev:worker": "tsx watch src/main-worker.ts",
    "dev:bot": "tsx watch src/main-bot.ts",
    "notification:trigger": "tsx src/main-notification-trigger.ts",
    "analytics:report": "tsx src/main-analytics-report.ts",
    "performance:voice": "tsx src/main-voice-performance-report.ts",
    "queues:inspect": "tsx src/main-queue-inspect.ts",
    "predev:api": "npm run build --workspace @mezgeb/contracts",
    "predev:bot": "npm run build --workspace @mezgeb/contracts",
    "predev:worker": "npm run build --workspace @mezgeb/contracts",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "telegram:sync": "tsx src/main-telegram-sync.ts",
    "identity:backfill": "tsx src/main-identity-backfill.ts",
    "start:telegram-sync": "node dist/main-telegram-sync.js",
    "start:identity-backfill": "node dist/main-identity-backfill.js",
    "start:admin-create": "node dist/main-admin-create.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:reset": "prisma migrate reset --force",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@mezgeb/contracts": "0.1.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "grammy": "^1.45.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.9",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
