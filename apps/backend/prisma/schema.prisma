generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  AM @map("am")
  EN @map("en")
}

enum UserStatus {
  PENDING_CONSENT @map("pending_consent")
  ACTIVE          @map("active")
  PAUSED          @map("paused")
  DELETING        @map("deleting")
  DELETED         @map("deleted")
}

enum ConsentAction {
  ACCEPTED  @map("accepted")
  WITHDRAWN @map("withdrawn")
}

enum UpdateStatus {
  RECEIVED   @map("received")
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

enum TransactionSource {
  VOICE   @map("voice")
  TEXT    @map("text")
  RECEIPT @map("receipt")
}

enum TransactionType {
  INCOME  @map("income")
  EXPENSE @map("expense")
}

enum FinancialEventKind {
  INCOME         @map("income")
  EXPENSE        @map("expense")
  LOAN_RECEIVED  @map("loan_received")
  LOAN_REPAYMENT @map("loan_repayment")
  REFUND         @map("refund")
  REIMBURSEMENT  @map("reimbursement")
}

