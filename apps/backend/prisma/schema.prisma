enum InteractionKind {
  CONSENT               @map("consent")
  CLARIFY_TYPE          @map("clarify_type")
  CLARIFY_AMOUNT        @map("clarify_amount")
  CLARIFY_FINANCIAL     @map("clarify_financial")
  CONFIRM_FINANCIAL     @map("confirm_financial")
  CONFIRM_LARGE_AMOUNT  @map("confirm_large_amount")
  CONFIRM_RECEIPT       @map("confirm_receipt")
  CONFIRM_UNDO          @map("confirm_undo")
  CONFIRM_DELETE_STEP_1 @map("confirm_delete_step_1")
  CONFIRM_DELETE_STEP_2 @map("confirm_delete_step_2")
}

enum InteractionState {
  PENDING   @map("pending")
  RESOLVED  @map("resolved")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")
}

enum NotificationKind {
  MORNING_REMINDER @map("morning_reminder")
  NIGHT_STATUS     @map("night_status")
  WEEKLY_SUMMARY   @map("weekly_summary")
  MONTHLY_SUMMARY  @map("monthly_summary")
}

enum NotificationDeliveryStatus {
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  SENT       @map("sent")
  SKIPPED    @map("skipped")
  FAILED     @map("failed")
}

enum IdentityProvider {
  TELEGRAM @map("telegram")
  GOOGLE   @map("google")
  APPLE    @map("apple")
  PHONE    @map("phone")
  EMAIL    @map("email")
}

enum IdentityEventType {
  CREATED         @map("created")
  OIDC_BOUND      @map("oidc_bound")
  LINKED          @map("linked")
  CONFLICT        @map("conflict")
  UNLINKED        @map("unlinked")
  SESSION_REVOKED @map("session_revoked")
}

enum IdentityChannel {
  TELEGRAM_BOT     @map("telegram_bot")
  TELEGRAM_MINIAPP @map("telegram_miniapp")
  FLUTTER          @map("flutter")
  WEB              @map("web")
  BACKFILL         @map("backfill")
  ADMIN_RECOVERY   @map("admin_recovery")
}

enum CustomerClientType {
  FLUTTER_ANDROID @map("flutter_android")
  FLUTTER_IOS     @map("flutter_ios")
  WEB             @map("web")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  telegramId     BigInt?    @unique @map("telegram_id")
  firstName      String?    @map("first_name") @db.VarChar(120)
  lastName       String?    @map("last_name") @db.VarChar(120)
  username       String?    @map("username") @db.VarChar(120)
  photoFileId    String?    @map("photo_file_id") @db.VarChar(255)
  language       Language   @default(AM)
  status         UserStatus @default(PENDING_CONSENT)
  consentVersion String?    @map("consent_version") @db.VarChar(20)
  consentAt      DateTime?  @map("consent_at") @db.Timestamptz(3)
  morningEnabled Boolean    @default(true) @map("morning_enabled")
  morningTime    DateTime   @default(dbgenerated("'08:00:00'::time without time zone")) @map("morning_time") @db.Time(0)
  nightEnabled   Boolean    @default(true) @map("night_enabled")
  nightTime      DateTime   @default(dbgenerated("'21:00:00'::time without time zone")) @map("night_time") @db.Time(0)
  appCodeHash    String?    @map("app_code_hash") @db.VarChar(72)
  appCodePrefix  String?    @map("app_code_prefix") @db.VarChar(4)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  consentRecords         ConsentRecord[]
  processedUpdates       ProcessedUpdate[]
  transactionGroups      TransactionGroup[]
  transactions           Transaction[]
  pendingInteractions    PendingInteraction[]
  events                 Event[]
  notificationDeliveries NotificationDelivery[]
  identities             UserIdentity[]
  customerSessions       CustomerSession[]
  identityLinkEvents     IdentityLinkEvent[]
  idempotencyRecords     IdempotencyRecord[]
  userCategories         UserCategory[]

  @@index([appCodePrefix])
  @@map("users")
}

model UserIdentity {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  provider            IdentityProvider
  providerSubject     String           @map("provider_subject") @db.VarChar(255)
  oidcSubject         String?          @map("oidc_subject") @db.VarChar(255)
  telegramUserId      BigInt?          @map("telegram_user_id")
  profileDisplayName  String?          @map("profile_display_name") @db.VarChar(160)
  profileUsername     String?          @map("profile_username") @db.VarChar(120)
  profilePictureUrl   String?          @map("profile_picture_url") @db.Text
  verifiedAt          DateTime         @map("verified_at") @db.Timestamptz(3)
  lastAuthenticatedAt DateTime         @map("last_authenticated_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerSessions   CustomerSession[]
  identityLinkEvents IdentityLinkEvent[]

  @@unique([provider, providerSubject])
  @@unique([provider, oidcSubject])
  @@unique([provider, telegramUserId])
  @@index([userId])
  @@map("user_identities")
}

model CustomerSession {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  identityId   String?            @map("identity_id") @db.Uuid
  clientType   CustomerClientType @map("client_type")
  deviceName   String?            @map("device_name") @db.VarChar(160)
  appVersion   String?            @map("app_version") @db.VarChar(40)
  lastUsedAt   DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?            @map("revoke_reason") @db.VarChar(80)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity      UserIdentity?          @relation(fields: [identityId], references: [id], onDelete: SetNull)
  refreshTokens CustomerRefreshToken[]

  @@index([userId, revokedAt])
  @@index([identityId, revokedAt])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("customer_refresh_tokens")
}

model IdentityLinkEvent {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  identityId    String?           @map("identity_id") @db.Uuid
  eventType     IdentityEventType @map("event_type")
  channel       IdentityChannel
  correlationId String?           @map("correlation_id") @db.VarChar(80)
  metadata      Json?
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  identity UserIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([identityId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt])
  @@map("identity_link_events")
}

model NotificationDelivery {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @map("user_id") @db.Uuid
  kind             NotificationKind
  periodKey        String                     @map("period_key") @db.VarChar(80)
  deterministicKey String                     @unique @map("deterministic_key") @db.VarChar(180)
  status           NotificationDeliveryStatus @default(QUEUED)
  attemptCount     Int                        @default(0) @map("attempt_count")
  scheduledFor     DateTime                   @map("scheduled_for") @db.Timestamptz(3)
  sentAt           DateTime?                  @map("sent_at") @db.Timestamptz(3)
  lastErrorCode    String?                    @map("last_error_code") @db.VarChar(80)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([status, scheduledFor])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

model ConsentRecord {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  version    String        @db.VarChar(20)
  action     ConsentAction
  recordedAt DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)])
  @@map("consent_records")
}

model ProcessedUpdate {
  telegramUpdateId  BigInt       @id @map("telegram_update_id")
  userId            String?      @map("user_id") @db.Uuid
  telegramChatId    BigInt?      @map("telegram_chat_id")
  telegramMessageId BigInt?      @map("telegram_message_id")
  updateType        String       @map("update_type") @db.VarChar(30)
  status            UpdateStatus @default(RECEIVED)
  attemptCount      Int          @default(0) @map("attempt_count")
  receivedAt        DateTime     @default(now()) @map("received_at") @db.Timestamptz(3)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(3)
  lastErrorCode     String?      @map("last_error_code") @db.VarChar(80)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([userId, receivedAt(sort: Desc)])
  @@map("processed_updates")
}

model TransactionGroup {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  telegramUpdateId    BigInt            @map("telegram_update_id")
  telegramMessageId   BigInt            @map("telegram_message_id")
  source              TransactionSource
  messageAt           DateTime          @map("message_at") @db.Timestamptz(3)
  rawTranscript       String?           @map("raw_transcript")
  receiptImagePath    String?           @map("receipt_image_path") @db.VarChar(255)
  transcriptExpiresAt DateTime?         @map("transcript_expires_at") @db.Timestamptz(3)
  sttProvider         String?           @map("stt_provider") @db.VarChar(50)
  sttModel            String?           @map("stt_model") @db.VarChar(100)
  extractionModel     String            @map("extraction_model") @db.VarChar(100)
  promptVersion       String            @map("prompt_version") @db.VarChar(30)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  undoneAt            DateTime?         @map("undone_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, telegramMessageId])
  @@index([userId, messageAt(sort: Desc)])
  @@map("transaction_groups")
}

model Transaction {
  id         String              @id @default(uuid()) @db.Uuid
  groupId    String              @map("group_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  type       TransactionType
  kind       FinancialEventKind
  amountEtb  Decimal             @map("amount_etb") @db.Decimal(12, 2)
  category   String              @db.VarChar(100)
  note       String?             @db.VarChar(500)
  platform   String?             @map("platform") @db.VarChar(50)
  occurredAt DateTime            @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  group TransactionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, type, occurredAt])
  @@index([userId, platform])
  @@map("transactions")
}

model PendingInteraction {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  kind           InteractionKind
  state          InteractionState @default(PENDING)
  payload        Json
  sourceUpdateId BigInt?          @map("source_update_id")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state, expiresAt])
  @@index([expiresAt, state])
  @@map("pending_interactions")
}

model Event {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(50)
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@map("events")
}

model UserCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(100)
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  usedCount Int      @default(0) @map("used_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId, type])
  @@map("user_categories")
}

model DeletionAudit {
  id                      String   @id @default(uuid()) @db.Uuid
  deletionPolicyVersion   String   @map("deletion_policy_version") @db.VarChar(20)
  consentVersionWithdrawn String?  @map("consent_version_withdrawn") @db.VarChar(20)
  completedAt             DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  result                  String   @db.VarChar(30)

  @@map("deletion_audits")
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("analytics_viewer") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  operation    String   @db.VarChar(100)
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  status       String   @db.VarChar(20)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
