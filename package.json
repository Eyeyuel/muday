{
  "name": "mezgeb",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Telegram voice expense tracker",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mezgeb/contracts && npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build",
    "ci": "npm run repo:check && npm run db:validate && npm run db:generate && npm run db:migrate:deploy && npm run verify && npm run test:integration --workspace @mezgeb/backend",
    "test:docker": "npm run db:validate && npm run db:generate && npm run db:migrate:deploy && npm run verify && npm run test:integration --workspace @mezgeb/backend",
    "repo:check": "node scripts/repository-check.mjs",
    "typecheck": "npm run build --workspace @mezgeb/contracts && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "dev": "concurrently --kill-others --names api,worker,miniapp --prefix-colors blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:miniapp\"",
    "dev:api": "npm run dev:api --workspace @mezgeb/backend",
    "dev:worker": "npm run dev:worker --workspace @mezgeb/backend",
    "dev:bot": "npm run dev:bot --workspace @mezgeb/backend",
    "notification:trigger": "npm run notification:trigger --workspace @mezgeb/backend --",
    "telegram:sync": "npm run telegram:sync --workspace @mezgeb/backend",
    "identity:backfill": "npm run identity:backfill --workspace @mezgeb/backend --",
    "analytics:report": "npm run analytics:report --workspace @mezgeb/backend --",
    "admin:create": "npx tsx scripts/admin-create.ts",
    "seed:dashboard": "npx tsx scripts/seed-executive-dashboard.ts",
    "backup:create": "node scripts/backup-create.mjs",
    "backup:restore:test": "node scripts/backup-restore-test.mjs",
    "queues:inspect": "npm run queues:inspect --workspace @mezgeb/backend",
    "security:check": "npm run repo:check && npm audit --omit=dev --audit-level=high",
    "prod:config": "PRODUCTION_ENV_FILE=.env.production.example docker compose --env-file .env.production.example -f docker-compose.production.yml config",
    "performance:dashboard": "node scripts/dashboard-benchmark.mjs",
    "performance:voice": "npm run performance:voice --workspace @mezgeb/backend",
    "release:rehearse": "node scripts/release-rehearsal.mjs",
    "dev:miniapp": "npm run dev --workspace @mezgeb/miniapp",
    "dev:landing": "npm --prefix apps/landing run dev",
    "db:generate": "npm run db:generate --workspace @mezgeb/backend",
    "db:migrate": "npm run db:migrate --workspace @mezgeb/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @mezgeb/backend",
    "db:migrate:create": "npm run db:migrate:create --workspace @mezgeb/backend",
    "db:reset": "npm run db:reset --workspace @mezgeb/backend",
    "db:validate": "npm run db:validate --workspace @mezgeb/backend",
    "db:studio": "npm run db:studio --workspace @mezgeb/backend",
    "setup:local": "npm run infra:up && npm run db:generate && npm run db:migrate",
    "docker:local:build": "docker compose build",
    "docker:local:up": "docker compose up -d --wait",
    "docker:local:restart": "docker compose restart",
    "docker:local:rebuild": "docker compose up -d --build --wait",
    "docker:local:down": "docker compose down",
    "docker:local:logs": "docker compose logs -f muday-api muday-worker muday-bot muday-miniapp muday-landing",
    "docker:local:test": "docker compose --profile test run --rm muday-test",
    "infra:up": "docker compose up -d --wait muday-postgres muday-redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f muday-postgres muday-redis",
    "infra:status": "docker compose ps",
    "local:check": "node scripts/local-check.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
